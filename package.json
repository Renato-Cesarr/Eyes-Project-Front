{
  "name": "eyes-project-front",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:ci": "ng test --watch=false --browsers=chromium --coverage",
    "e2e": "playwright test",
    "e2e:quality": "playwright test e2e/accessibility-matrix.spec.ts e2e/visual-regression.spec.ts",
    "e2e:visual": "playwright test e2e/visual-regression.spec.ts",
    "e2e:visual:update": "playwright test e2e/visual-regression.spec.ts --update-snapshots",
    "e2e:report": "playwright show-report",
    "design-system:validate": "node scripts/validate-design-system.mjs",
    "design-system:catalog": "ng serve --configuration development",
    "sonar": "sonar-scanner-npm",
    "qa:real": "node scripts/verify-real-product-flows.mjs"
  },
  "private": true,
  "packageManager": "npm@10.9.8",
  "engines": {
    "node": "22.23.2",
    "npm": "10.9.8"
  },
  "dependencies": {
    "@angular/animations": "^21.2.25",
    "@angular/cdk": "^21.2.14",
    "@angular/common": "^21.2.25",
    "@angular/compiler": "^21.2.25",
    "@angular/core": "^21.2.25",
    "@angular/forms": "^21.2.25",
    "@angular/material": "^21.2.14",
    "@angular/platform-browser": "^21.2.25",
    "@angular/router": "^21.2.25",
    "@fontsource/atkinson-hyperlegible": "5.3.0",
    "@fontsource/lexend": "5.3.0",
    "material-symbols": "0.47.5",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "^0.16.2"
  },
  "devDependencies": {
    "@angular/build": "^21.2.25",
    "@angular/cli": "^21.2.26",
    "@angular/compiler-cli": "^21.2.25",
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@sonar/scan": "5.0.1",
    "@vitest/browser-playwright": "^4.1.11",
    "@vitest/coverage-istanbul": "^4.1.11",
    "@vitest/coverage-v8": "^4.1.11",
    "jsdom": "^28.0.0",
    "prettier": "^3.8.1",
    "typescript": "~5.9.2",
    "vitest": "^4.1.11"
  }
}
